  "keyFeatures": [
    "Visual drag-and-drop UI builder with 45+ pre-built widgets",
    "Native integrations with 25+ databases including PostgreSQL, MySQL, MongoDB, Redis",
    "REST API and GraphQL support with OAuth2 authentication",
    "JavaScript editor for custom logic and transformations",
    "Git-based version control for collaborative development",
    "Self-hosted deployment via Docker, Kubernetes, AWS, and more",
    "Role-based access control (RBAC) and workspace management",
    "AI integrations with OpenAI, Anthropic, and Google AI",
    "Template library for rapid application bootstrapping",
    "Custom JavaScript libraries support"
  ],
  "publicApiSurface": [
    "GET /api/v1/applications - List applications",
    "POST /api/v1/applications - Create application",
    "GET /api/v1/pages/{pageId} - Get page",
    "POST /api/v1/actions - Create action/query",
    "POST /api/v1/actions/execute - Execute action",
    "GET /api/v1/datasources - List datasources",
    "POST /api/v1/datasources - Create datasource",
    "GET /api/v1/plugins - List plugins",
    "POST /api/v1/users/forgotPassword - Password reset",
    "GET /api/v1/workspaces - List workspaces",
    "POST /api/v1/git/connect - Connect git repository",
    "GET /api/v1/themes - List themes"
  ]
